# ==========================================
# GitHub Repo Analyzer — Docker Environment Configuration
# ==========================================

# Port Configuration
FRONTEND_PORT=80
CLIENT_URL=http://localhost

# GitHub Personal Access Token (PAT)
# Required to fetch repository stats, trees, releases, and commits with high rate limits
# Generate a token at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Google Gemini AI API Key
# Optional: powers AI summaries, code review, and architecture insights
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# API Key Validation (Optional)
# Set to 'true' to restrict API endpoints to authorized clients
REQUIRE_API_KEY=false
API_KEY=your_secure_api_key_here
