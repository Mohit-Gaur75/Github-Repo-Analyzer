# Backend API Configuration
# Point frontend to backend API server
# Local development (default): http://localhost:5001/api
# Production: your-backend-domain.com/api
VITE_API_BASE_URL=http://localhost:5001/api

# API Key (only needed if backend enforces API key validation in production)
# Contact backend team for this key if you're deploying to production
# Only set this if the backend has REQUIRE_API_KEY=true
# VITE_API_KEY=your_api_key_here
