# Server
PORT=5001
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/github-analyzer

# GitHub Personal Access Token (fine-grained or classic)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Frontend origin (for CORS)
CLIENT_URL=http://localhost:5173

# API Key (used in production to protect endpoints)
API_KEY=your_strong_random_api_key_here
