# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Database
# Local development: mongodb://localhost:27017/github-analyzer
# MongoDB Atlas (cloud): mongodb+srv://<user>:<password>@cluster.mongodb.net/github-analyzer
# Replace <user> and <password> with your MongoDB credentials
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/github-analyzer

# GitHub Personal Access Token
# Required to fetch repository data from GitHub API
# Create a token at: https://github.com/settings/tokens
# Use fine-grained PAT with 'repo' scope for best security
# Example token: ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Frontend Origin (for CORS)
# Tells backend which frontend URL is allowed to access this API
# Default for local development: http://localhost:5173 (Vite)
CLIENT_URL=http://localhost:5173

# API Key for Production Security
# Set REQUIRE_API_KEY=true to enforce API key validation
# Generate a strong random string for production deployments
# Example: openssl rand -base64 32
# Only required if REQUIRE_API_KEY environment variable is set to "true"
REQUIRE_API_KEY=false
API_KEY=your_strong_random_api_key_here
